# Build only the Receptor executable; never publish this intermediate image.
FROM golang:1.26.9 AS builder
RUN git clone https://github.com/ansible/receptor.git /source
WORKDIR /source
RUN git checkout --detach 8a95593179b27454b7e46629e91c59d9a73a9620 && \
    go get golang.org/x/crypto@v0.55.0 golang.org/x/net@v0.60.0 golang.org/x/text@v0.42.0 && \
    go mod tidy && \
    CGO_ENABLED=0 go build -trimpath -o /out/receptor ./cmd/receptor-cl
